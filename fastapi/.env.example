# 환경변수 예시 — 그대로 복사해 fastapi/.env 하나로 쓴다.
#
#   cp .env.example .env
#
# api 와 auth 두 서비스가 이 파일 하나를 공유한다 (.env.backend / .env.auth 분리 폐지).
# docker-compose.yml 이 같은 디렉터리에 있어 자동 로드된다 (--env-file 불필요):
#   cd fastapi && docker compose up -d
#
# [주의] 키 분리가 파일 경계로는 더 이상 강제되지 않는다.
# JWT_PRIVATE_KEY 가 api 컨테이너에도 로드되므로, 개인키를 컨테이너 밖으로 내보내지
# 않는 책임은 코드에 남는다 — main.py(api) 는 개인키를 읽지 않고 공개키로만 검증하며,
# 토큰 발급은 auth_main.py 에서만 한다. 이 경계를 깨는 코드를 추가하지 않는다.
#
# 실제 파일(.env*)은 전부 커밋 금지다.

# ============================================================
# DB / 캐시 / LLM / CORS
# ============================================================

DATABASE_URL=postgresql://ragtaylor_user:CHANGE_ME@postgres:5432/ragtaylor_db
# [확인 필요] 통합 전 .env 는 redis://redis:6379/1, .env.auth 는 redis://totem:6379/1 이었다.
# 한 파일로 합치면 값이 하나여야 하므로, dreamscape 서비스명(limbo/totem)에 맞는 totem 을 남겼다.
# inception 저장소의 실제 서비스명과 다르면 이 값을 고쳐야 한다 (DATABASE_URL 의 postgres 호스트도 함께).
REDIS_URL=redis://totem:6379/1
CORS_ORIGINS=https://api.ragtaylor.com,https://ragtaylor.com,https://www.ragtaylor.com

# Ollama — 코드가 실제로 읽는 변수는 아래 두 개다. 모든 LLM/임베딩 경로가
# 이 값을 공유한다 (FakerOrchestrator, kerrigan 챗봇, morningstar 인사이트).
# 사양 낮은 머신에서 파이프라인 확인용으로 가장 가벼운 모델로 통일했다.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=exaone3.5:2.4b
# 임베딩 전용 모델. 채팅 모델과 반드시 분리한다 — completion 모델(exaone3.5:2.4b 등)은
# Ollama가 임베딩 모드로 기동하지 않아 /api/embeddings 가 동작하지 않는다.
# 이 값을 바꾸면 KnowledgeChunkOrm.EMBEDDING_DIM 과 마이그레이션도 함께 고쳐야 한다.
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_URL 은 어떤 코드도 읽지 않는다 (OLLAMA_BASE_URL 로 대체됨).
OLLAMA_URL=http://host.docker.internal:11434

# 로컬 pgvector 컨테이너용 (docker compose --profile local-db) — 운영에서는 쓰이지 않는다.
# 이 컨테이너를 주 DB로 쓰려면 위 DATABASE_URL을 아래 값으로 덮어쓴다.
#   컨테이너 안에서 접속: postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgvector:5432/${POSTGRES_DB}
#   호스트에서 uvicorn 실행 시: postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
POSTGRES_USER=ragtaylor_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ragtaylor_db

# 기존 로컬 스택(n8n/neo4j)용 — dreamscape와 무관
GEMINI_API_KEY=CHANGE_ME
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# 로그인 게이트 (003) — 실제 값은 서버 .env에만 입력
AUTH_ID=CHANGE_ME
AUTH_PW=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# star_craft — ConvNeXt Nano 이미지 분류 (zerg_observer, star-002)
INFERENCE_BACKEND=onnx
ZERG_OBSERVER_MODEL_NAME=convnext_nano
ZERG_OBSERVER_MAX_IMAGE_BYTES=10485760
ZERG_OBSERVER_CACHE_TTL_SECONDS=3600

# kingsman — 소셜 로그인 (구글/네이버/카카오/X)
# 클라이언트 시크릿을 실제로 읽는 쪽은 kingsman(api 서비스)이다.
# redirect_uri는 반드시 "{OAUTH_REDIRECT_BASE_URL}/api/kingsman/oauth/{provider}/callback"
# 형태로 각 프로바이더 콘솔에 등록된 값과 정확히 일치해야 한다.
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
FRONTEND_REDIRECT_URL=http://localhost:3000
USER_SESSION_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME

# 카카오 OIDC 로그인 (fast-003) — auth 서비스의 POST /auth/kakao/login 이 쓴다.
# id_token 의 aud 는 카카오 앱의 REST API 키다. 모바일·웹이 같은 카카오 앱을 쓰므로
# 위 KAKAO_CLIENT_ID 하나를 그대로 검증에 재사용한다(별도 키를 추가하지 않는다).
# 아래 세 값은 기본값이 코드에 있으므로 바꿀 일이 있을 때만 설정한다.
KAKAO_OIDC_ISSUER=https://kauth.kakao.com
KAKAO_OIDC_CONFIG_URL=https://kauth.kakao.com/.well-known/openid-configuration
KAKAO_OIDC_CACHE_TTL_SECONDS=21600

# 플랫폼별 토큰 수명. 모바일 세션과 웹 세션은 서로 독립이다.
ACCESS_TTL_WEB_MIN=30
REFRESH_TTL_WEB_DAYS=7
ACCESS_TTL_MOBILE_MIN=60
REFRESH_TTL_MOBILE_DAYS=30
X_CLIENT_ID=CHANGE_ME
X_CLIENT_SECRET=CHANGE_ME

# ============================================================
# JWT (RS256) — api 와 auth 가 이 값들을 함께 읽는다
# 파일이 하나이므로 키 값을 두 번 적지 않는다. 같은 키를 중복 정의하면
# 마지막 값이 조용히 이겨서 추적하기 어려운 버그가 된다.
# ============================================================

# 개인키. PEM 원문 또는 base64 인코딩(base64 -w0 jwt_private.pem) 모두 허용.
# 토큰 발급(auth_main.py)에서만 쓰인다. api 컨테이너에도 로드되지만 main.py 는 읽지 않는다.
JWT_PRIVATE_KEY=

# 공개키. api 는 검증에, auth 는 리프레시 토큰 검증(/refresh, /logout)에 쓴다.
# (공개키는 비밀이 아니다)
JWT_PUBLIC_KEY=

# 발급·검증 양쪽이 같은 값을 봐야 토큰 검증이 통과한다.
SERVICE_AUD=ragtaylor-api
